generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model WaitlistUser {
  id         String   @id @default(cuid())
  email      String   @unique
  utm        String?
  joinedAt   DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
